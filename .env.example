# Valkey のパスワード（必須）。
VALKEY_PASSWORD=change-me

# ---- 認証ベクターAPI ----

# mTLS リスナーを公開するホスト側のアドレスとポート。
AKA_AV_TLS_PUBLISH=0.0.0.0:8443

# 自己署名のサーバー証明書を初回起動時に自動生成するとき、SAN に入れるホスト名と IP アドレス。
# クライアントが接続に使う名前や IP アドレスをカンマ区切りで指定する。
# 生成済みの証明書には反映されない（管理API の証明書削除で作り直せる）。
AKA_AV_TLS_HOSTS=localhost,127.0.0.1,aka-only-server

# 平文HTTP リスナー。空なら無効。有効にする場合は :8080 を指定する。
# CK/IK が平文で流れるため、同一ホスト上のクライアント専用とすること。
AKA_AV_PLAIN_ADDR=
# 平文HTTP リスナーを公開するホスト側のアドレスとポート。ループバック以外にしないこと。
AKA_AV_PLAIN_PUBLISH=127.0.0.1:8080

# ---- 管理API ----

# 管理クライアント。「識別名=証明書の SHA-256 フィンガープリント」をカンマ区切りで指定する。
# 空なら管理API を起動しない。
# 例: AKA_ADMIN_CLIENTS=bff=0123...cdef
AKA_ADMIN_CLIENTS=

# 管理API を公開するホスト側のアドレスとポート。
# BFF を別ホストで動かす場合は、そのホストから届くアドレスに変える。
AKA_ADMIN_PUBLISH=127.0.0.1:9443

# 管理API 用の自己署名サーバー証明書の SAN。生成済みの証明書には反映されない
# （admin-cert reset コマンドで作り直せる）。
AKA_ADMIN_TLS_HOSTS=localhost,127.0.0.1,aka-only-server

# ---- その他 ----

# 同一ホスト上の別の compose プロジェクトと共有する Docker ネットワークの名前。
AKA_SHARED_NETWORK=aka-av

# ログレベル（debug / info / warn / error）。
AKA_LOG_LEVEL=info
# 管理API で返すためにメモリに保持するログの件数。
AKA_LOG_BUFFER=1000
# 監査ログの保持件数の上限。
AKA_AUDIT_MAX=10000
